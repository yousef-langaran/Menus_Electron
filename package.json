{
  "name": "secoin-electron",
  "version": "2.6.0",
  "description": "Electron app for restaurant order management with offline support",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3002 && npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && electron dist/main.js",
    "build": "npm run build:electron && npm run build:react",
    "build:react": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/write-packaged-update-env.js",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish always",
    "dist:win": "npm run build && electron-builder --win --publish always",
    "postdist:win": "node scripts/copy-env-example.js",
    "dist:linux": "npm run build && electron-builder --linux --publish always",
    "rebuild": "electron-rebuild -f -w serialport"
  },
  "keywords": [
    "electron",
    "restaurant",
    "orders",
    "offline"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@tanstack/react-virtual": "^3.13.26",
    "axios": "^1.7.9",
    "dexie": "^3.2.4",
    "dotenv": "^17.2.4",
    "electron-updater": "^6.3.9",
    "framer-motion": "^11.16.4",
    "node-hid": "^3.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^6.26.0",
    "serialport": "^12.0.0",
    "socket.io-client": "^4.8.1",
    "usb": "^2.17.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.menus.electron",
    "productName": "secoin",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://update.secoin.ir"
      }
    ],
    "protocols": [
      {
        "name": "secoin",
        "schemes": [
          "secoin"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "dist-react/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "artifactName": "Secoin-Setup.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Secoin",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  }
}
