# آدرس API بک‌اند (الکترون از این استفاده می‌کند)
# می‌توانید فقط host بدهید؛ در این صورت /api/v1 خودکار اضافه می‌شود
API_BASE_URL=http://localhost:3001
# یا آدرس کامل:
# API_BASE_URL=http://localhost:3001/api/v1

# برای build ویترین (اختیاری؛ در زمان build در کد درج می‌شود)
VITE_API_BASE_URL=http://localhost:3001
VITE_API_BASE_VERSION=/api/v1
