# آدرس API — در حالت build این فایل را کنار exe بگذار یا در userData (پوشهٔ AppData برنامه)
# یکی از اینها را ست کن (فقط host کافیه؛ /api/v1 خودکار اضافه می‌شود):
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# API_BASE_URL=http://localhost:3001
# VITE_API_BASE_URL=http://localhost:3001

# آدرس سرور بروزرسانی خودکار (اختیاری). باید پوشهٔ release بعد از build را روی این آدرس سرو کنید.
# UPDATE_SERVER_URL=https://your-domain.com/updates
